{
  "name": "cgswitch",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "version": "0.3.11",
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "dev": "pnpm sync-version && vite",
    "dev:tauri": "pnpm sync-version && tauri dev",
    "build": "pnpm sync-version && vite build",
    "build:debug": "pnpm sync-version && tauri build --debug",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm typecheck && pnpm check:rust",
    "check:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "pnpm sync-version && tauri"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@phosphor-icons/vue": "2.2.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "codemirror": "6.0.2",
    "naive-ui": "2.44.1",
    "vue": "3.5.41",
    "vue-codemirror": "6.1.1",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vue-tsc": "3.3.10"
  }
}
